# Relational Database (PostgreSQL / Neon)
# e.g., postgresql://user:pass@ep-cool.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codegraph"

# CORS Allowed Origins (Comma-separated for local dev and Vercel domains)
CORS_ORIGINS="https://your-app-name.vercel.app,http://localhost:5173,http://localhost:3000"

# Neo4j Graph Database (Local or AuraDB Cloud)
# - Local Docker: bolt://localhost:7687
# - AuraDB: neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"

# Qdrant Vector Database (Local path or Qdrant Cloud)
# - Cloud: https://<your-cluster>.cloud.qdrant.io:6333
# - Leave QDRANT_HOST unset or non-http to use local embedded storage (./qdrant_data)
QDRANT_HOST=""
QDRANT_API_KEY=""

# AI Provider Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Application Security
JWT_SECRET="codegraph-rag-secret-key-2026-production-v2"
PORT=8000
