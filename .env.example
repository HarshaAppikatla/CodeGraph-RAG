# Google Gemini AI API Key (Optional BYOK - can also be configured in the UI)
GEMINI_API_KEY=""

# Neo4j Graph Database Configuration
# - For local Docker instance: bolt://localhost:7687
# - For Neo4j Aura Cloud free instance: neo4j+s://<your-db-id>.databases.neo4j.io
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
