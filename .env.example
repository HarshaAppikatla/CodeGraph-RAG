# Backend Database (Neon PostgreSQL or SQLite)
# - For Neon PostgreSQL: postgresql://user:pass@ep-cool.neon.tech/neondb?sslmode=require
# - For local SQLite: sqlite:///./codegraph.db
DATABASE_URL="sqlite:///./codegraph.db"

# CORS Origins (Render Backend)
CORS_ORIGINS="https://your-app-name.vercel.app,http://localhost:5173,http://localhost:3000"

# Neo4j Graph Database
# - Local Docker: bolt://localhost:7687
# - Neo4j AuraDB Cloud: neo4j+s://<your-db-id>.databases.neo4j.io
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Qdrant Vector Store
# - Qdrant Cloud: https://<your-cluster>.cloud.qdrant.io:6333
# - Leave unset for embedded local storage in ./qdrant_data
QDRANT_HOST=""
QDRANT_API_KEY=""

# AI Provider Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Application Security
# Set a unique 32+ character random secret (generate via: openssl rand -hex 32)
JWT_SECRET=""
# Dedicated credential encryption key (never rotate once set, keeps stored API keys valid)
ENCRYPTION_KEY=""
